EventTicket_Text_ShowOldSeaMap:
	.string "De veerboot naar SLATEPORT is…\p"
	.string "Wat zeg je?\n"
	.string "Kunnen we naar deze plek varen?\p"
	.string "Ik ken iemand die je beter kan helpen.\n"
	.string "Wacht even.$"

EventTicket_Text_ThatPass:
	.string "De veerboot naar SLATEPORT is…\p"
	.string "Oh?\n"
	.string "Die PAS…$"

EventTicket_Text_ShowEonTicket:
	.string "Ahoi, maatje, ben jij degene die\n"
	.string "die heel vreemde PAS meebracht?\p"
	.string "Ik zeg je, je wilt naar een klein\n"
	.string "eilandje ver in het zuiden.\p"
	.string "We weten niet wat we daar\n"
	.string "tegenkomen, ahoi.\l"
	.string "Dat geeft me de kriebels!\p"
	.string "Alle man aan boord!$"

EventTicket_Text_SouthernIslandSailBack:
	.string "Ahoi, maatje, er is niets te zien\n"
	.string "of te doen op dit saaie eiland.\p"
	.string "Zullen we terugvaren naar LILYCOVE?$"

EventTicket_Text_SailHome:
	.string "Ahoi, goed dan!\n"
	.string "We varen naar huis!$"

EventTicket_Text_AsYouLike:
	.string "Ahoi, goed, zoals je wilt.$"

SouthernIsland_Interior_Text_Sign:
	.string "“Alle dromen zijn een andere\n"
	.string "werkelijkheid. Vergeet nooit…”$"

SouthernIsland_Exterior_Text_Sign:
	.string "“Wie zijn herinneringen kwijtraakt,\n"
	.string "kerft ze in zijn hart…”$"
