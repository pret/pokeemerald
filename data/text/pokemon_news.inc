gPokeNewsTextBlendMaster_Ending::
	.string "Goedendag!\n"
	.string "Het is tijd voor POKéMON NIEUWS.\p"
	.string "Het is ongelooflijk!\n"
	.string "Zelfs te ongelooflijk!\p"
	.string "De BESSENMIXER draait in een\n"
	.string "duizelingwekkend tempo!\p"
