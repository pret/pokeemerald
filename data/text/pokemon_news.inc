gPokeNewsTextBlendMaster_Upcoming::
	.string "Goedendag!\n"
	.string "Het is tijd voor POKéMON NIEUWS.\p"
	.string "Groot nieuws voor iedereen die\n"
	.string "{POKEBLOCK}S maakt.\p"
	.string "De legendarische MIXMEESTER komt\n"
	.string "naar LILYCOVE CITY, nog maar\l"
	.string "{STR_VAR_1} dagen te gaan!\p"
	.string "De MIXMEESTER is de beste van heel\n"
	.string "HOENN in het draaien van\l"
	.string "een BESSENMIXER.\p"
	.string "Wie geweldige {POKEBLOCK}S wil maken of\n"
	.string "de MEESTER aan het werk wil zien,\l"
	.string "moet zijn BESSEN sparen.\p"
	.string "Dat was het POKéMON NIEUWS.$"

gPokeNewsTextBlendMaster_Ongoing::
	.string "Goedendag!\n"
	.string "Het is tijd voor POKéMON NIEUWS.\p"
	.string "Groot nieuws voor iedereen die\n"
	.string "{POKEBLOCK}S maakt.\p"
	.string "De legendarische MIXMEESTER is\n"
	.string "eindelijk gearriveerd!\p"
	.string "De MIXMEESTER draait aan de\n"
	.string "BESSENMIXER in de LILYCOVE\l"
