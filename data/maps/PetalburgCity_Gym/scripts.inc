	goto_if_set FLAG_DEFEATED_PETALBURG_GYM, PetalburgCity_Gym_EventScript_GymGuidePostVictory
	msgbox PetalburgCity_Gym_Text_GymGuideAdvice, MSGBOX_DEFAULT
	release
	end

PetalburgCity_Gym_EventScript_GymGuidePostVictory::
	msgbox PetalburgCity_Gym_Text_GymGuidePostVictory, MSGBOX_DEFAULT
	release
	end

PetalburgCity_Gym_EventScript_LeftGymStatue::
	lockall
	goto_if_set FLAG_BADGE05_GET, PetalburgCity_Gym_EventScript_GymStatueCertified
	goto PetalburgCity_Gym_EventScript_GymStatue
	end

PetalburgCity_Gym_EventScript_RightGymStatue::
	lockall
	goto_if_set FLAG_BADGE05_GET, PetalburgCity_Gym_EventScript_GymStatueCertified
	goto PetalburgCity_Gym_EventScript_GymStatue
	end

PetalburgCity_Gym_EventScript_GymStatueCertified::
	msgbox PetalburgCity_Gym_Text_GymStatueCertified, MSGBOX_DEFAULT
	releaseall
	end

PetalburgCity_Gym_EventScript_GymStatue::
	msgbox PetalburgCity_Gym_Text_GymStatue, MSGBOX_DEFAULT
	releaseall
	end

PetalburgCity_Gym_Text_DadYoureHereWithYourPokemon:
	.string "PAPA: Hm?\p"
	.string "Nou, als dat {PLAYER} niet is!\n"
	.string "Zijn jullie klaar met verhuizen?\p"
	.string "Knap dat je hier helemaal\n"
	.string "alleen naartoe bent gekomen.\p"
	.string "O, ik zie het al.\n"
	.string "Je hebt een POKéMON bij je.\p"
	.string "Hm… Dus jij wordt ook een\n"
	.string "TRAINER, net als ik, {PLAYER}.\p"
	.string "Dat is goed nieuws!\n"
	.string "Ik heb er zin in!$"

PetalburgCity_Gym_Text_WallyIdLikeAPokemon:
	.string "Eh… Ik…\n"
	.string "Ik wil graag een POKéMON, alstublieft…$"

PetalburgCity_Gym_Text_DadOhYoureWallyRight:
	.string "PAPA: Hm? Jij bent… Eh… O ja.\n"
	.string "Jij bent WALLY, toch?$"

PetalburgCity_Gym_Text_WallyIveNeverCaughtAPokemon:
	.string "WALLY: Ik ga logeren bij mijn familie\n"
	.string "in VERDANTURF TOWN.\p"
	.string "Ik denk dat ik me daar alleen voel,\n"
	.string "dus ik wil een POKéMON meenemen.\p"
	.string "Maar ik heb nog nooit een POKéMON\n"
	.string "gevangen. Ik weet niet hoe…$"

PetalburgCity_Gym_Text_DadHmISee:
	.string "PAPA: Hm. Ik snap het.$"

PetalburgCity_Gym_Text_DadPlayerGoWithWally:
	.string "PAPA: {PLAYER}, je hebt het\n"
	.string "gehoord, hè?\p"
	.string "Ga met WALLY mee en let op dat\n"
	.string "hij veilig een POKéMON vangt.$"

PetalburgCity_Gym_Text_IllLoanYouMyZigzagoon:
	.string "WALLY, hier, je mag mijn POKéMON\n"
	.string "lenen.\p"
	.string "WALLY krijgt een ZIGZAGOON!$"

PetalburgCity_Gym_Text_WallyThankYouAndDadGivesPokeBall:
	.string "WALLY: O, wauw!\n"
	.string "Een POKéMON!\p"
	.string "PAPA: Hm. Je krijgt ook een POKé BALL.\n"
	.string "Zet 'm op!\p"
	.string "WALLY krijgt een POKé BALL!$"

PetalburgCity_Gym_Text_WallyOhWowThankYou:
	.string "WALLY: O, wauw!\n"
	.string "Dank u wel!$"

PetalburgCity_Gym_Text_WouldYouReallyComeWithMe:
	.string "{PLAYER}… Wil je echt met\n"
	.string "mij mee?$"

PetalburgCity_Gym_Text_DadSoDidItWorkOut:
	.string "PAPA: Nou, is het gelukt?$"

PetalburgCity_Gym_Text_WallyThankYouBye:
	.string "WALLY: Ja, dank u wel, het is gelukt.\n"
	.string "Hier is uw POKéMON terug.\p"
	.string "{PLAYER}, bedankt dat je met me\n"
	.string "mee ging.\p"
	.string "Dankzij jullie heb ik mijn eigen\n"
	.string "POKéMON gevangen.\p"
	.string "Ik beloof dat ik er heel goed voor\n"
	.string "zal zorgen.\p"
	.string "O! Mijn moeder wacht op me,\n"
	.string "dus ik moet gaan!\p"
	.string "Doei, {PLAYER}!$"

PetalburgCity_Gym_Text_DadGoCollectBadges:
	.string "PAPA: Zo…\p"
	.string "{PLAYER}, wil je een sterke TRAINER\n"
	.string "worden? Dan is dit mijn advies.\p"
	.string "Ga naar RUSTBORO CITY, voorbij\n"
	.string "deze stad.\p"
	.string "Daar daag je GYMLEIDER\n"
	.string "ROXANNE uit.\p"
	.string "Daarna ga je naar andere\n"
	.string "POKéMON GYMS en versla je de LEIDERS.\p"
	.string "Verzamel hun BADGES,\n"
	.string "begrepen?\p"
	.string "Ik ben natuurlijk ook een GYMLEIDER.\n"
	.string "Ooit vechten wij, {PLAYER}.\p"
	.string "Maar pas als je veel sterker\n"
	.string "bent geworden.$"

PetalburgCity_Gym_Text_NormanGoToRustboro:
	.string "PAPA: Hm? Ga je niet naar de\n"
	.string "POKéMON GYM in RUSTBORO CITY?\p"
	.string "Tegen een beginnende TRAINER\n"
	.string "vechten is niks voor mij.\p"
	.string "{PLAYER}, daag me uit als je veel\n"
	.string "sterker bent geworden.\p"
	.string "Als je vier GYM BADGES hebt, vecht\n"
	.string "ik tegen je, {PLAYER}. Afgesproken?$"

PetalburgCity_Gym_Text_NormanGoToDewford:
	.string "PAPA: Zo… Je hebt de GYMLEIDER\n"
	.string "van RUSTBORO CITY verslagen.\p"
	.string "Maar er zijn nog veel TRAINERS\n"
	.string "die sterker zijn dan jij, {PLAYER}.\p"
	.string "Over de zee in DEWFORD TOWN is\n"
	.string "een GYMLEIDER, BRAWLY.\p"
	.string "Ga hem maar uitdagen.$"

PetalburgCity_Gym_Text_YouHaveGottenStronger:
	.string "PAPA: Hm… {PLAYER}, je bent\n"
	.string "sterker geworden.\p"
	.string "Dat zie ik aan het aantal BADGES\n"
	.string "dat je hebt.$"

PetalburgCity_Gym_Text_NormanIntro:
	.string "PAPA: Hm…\n"
	.string "Dus je hebt vier GYM BADGES.\p"
	.string "Goed, zoals beloofd gaan we\n"
	.string "nu vechten.\p"
	.string "{PLAYER}…\p"
	.string "Ik ben zo blij dat ik echt kan\n"
	.string "vechten tegen mijn eigen kind.\p"
	.string "Maar een gevecht is een gevecht!\p"
	.string "Als GYMLEIDER doe ik alles\n"
	.string "om te winnen.\p"
	.string "{PLAYER}, doe jij ook maar je\n"
	.string "uiterste best!$"

PetalburgCity_Gym_Text_NormanDefeat:
	.string "…\p"
	.string "Ik… Ik kan het niet…\p"
	.string "Ik kan het niet geloven. {PLAYER}…\p"
	.string "Heb ik van {PLAYER} verloren?\p"
	.string "Maar regels zijn regels!\n"
	.string "Hier, voor jou.$"

PetalburgCity_Gym_Text_ReceivedBalanceBadge:
	.string "{PLAYER} krijgt de BALANCE BADGE\n"
	.string "van PAPA!$"

PetalburgCity_Gym_Text_ExplainBalanceBadgeTakeThis:
	.string "PAPA: Met die BADGE wordt de\n"
	.string "VERDEDIGING van al je POKéMON hoger.\p"
	.string "POKéMON die de HM-aanval SURFEN\n"
	.string "kennen, kunnen over het water.\p"
	.string "Dit is mijn cadeau voor jou. {PLAYER},\n"
	.string "ik weet dat je het goed gebruikt.$"

PetalburgCity_Gym_Text_ExplainFacade:
	.string "PAPA: Op TM42 staat FAÇADE.\p"
	.string "De aanval wordt dubbel zo sterk als\n"
	.string "de POKéMON vergiftigd, verlamd of\l"
	.string "verbrand is.\p"
	.string "Zo kun je een slechte situatie\n"
	.string "omdraaien.$"

PetalburgCity_Gym_Text_DadHappyAndSad:
	.string "PAPA: Als GYMLEIDER ben ik er\n"
	.string "heel erg van balen…\p"
	.string "Maar als vader ben ik blij en\n"
	.string "ook een beetje verdrietig. Raar, hè…$"

PetalburgCity_Gym_Text_PleaseComeWithMe:
	.string "Ah, daar ben je, {PLAYER}{KUN}!\p"
	.string "Kom even met me mee.\n"
	.string "Ik heb iets voor je.$"

PetalburgCity_Gym_Text_LetMeBorrowPlayer:
	.string "NORMAN, je vindt het toch niet erg?\p"
	.string "Ik leen {PLAYER}{KUN} even een\n"
	.string "minuutje.$"

PetalburgCity_Gym_Text_DadGoingToKeepTraining:
	.string "PAPA: {PLAYER}, ga af en toe eens\n"
	.string "naar je moeder.\p"
	.string "Ik blijf hier en ga nog harder\n"
	.string "trainen.\p"
	.string "Als TRAINER wil ik dit verlies tegen\n"
	.string "jou goedmaken, {PLAYER}!$"

PetalburgCity_Gym_Text_DadNoAmountOfTrainingIsEnough:
	.string "PAPA: {PLAYER}, hoe gaat het?\p"
	.string "De wereld van POKéMON is heel diep.\p"
	.string "Ik denk echt dat je nooit genoeg\n"
	.string "kunt trainen.$"

PetalburgCity_Gym_Text_GymGuideAdvice:
	.string "Hé, hoe gaat het, toekomstige\n"
	.string "KAMPIOEN {PLAYER}?\p"
	.string "De deuren in deze GYM gaan open\n"
	.string "als je de TRAINERS verslaat.\p"
	.string "Oeps! De deuren hier zijn al open,\n"
	.string "dus val mij niet aan!\p"
	.string "De TRAINERS van PETALBURG GYM\n"
	.string "gebruiken allerlei voorwerpen.\p"
	.string "De linkerdeur gaat naar de\n"
	.string "SNELHEIDSKAMER.\p"
	.string "De rechterdeur gaat naar de\n"
	.string "RAAKKANSKAMER.\p"
	.string "De naam staat op de deur,\n"
	.string "dus kies goed.\p"
	.string "Als je een deur hebt gekozen…\n"
	.string "Nou, zet 'm op!$"

PetalburgCity_Gym_Text_GymGuidePostVictory:
	.string "{PLAYER}! Wauw! Je hebt zelfs je\n"
	.string "eigen vader verslagen!\p"
	.string "Echt, wauw!\n"
	.string "Wat een verrassing!$"

PetalburgCity_Gym_Text_RandallIntro:
	.string "Eerder aanvallen dan je\n"
	.string "tegenstander…\p"
	.string "Daarmee heb ik al een groot\n"
	.string "voordeel, vind je niet?$"

PetalburgCity_Gym_Text_RandallDefeat:
	.string "Dat was een prachtig gevecht!$"

PetalburgCity_Gym_Text_RandallPostBattle:
	.string "Ga naar de volgende kamer, daar\n"
	.string "wacht een nieuwe uitdaging.\p"
	.string "Links is de VERWARRINGSKAMER.\p"
	.string "De rechterdeur gaat naar de\n"
	.string "VERDEDIGINGSKAMER.$"

PetalburgCity_Gym_Text_RandallPostBadge:
	.string "Of je nu wint of verliest, je\n"
	.string "blijft altijd trainen met jezelf\l"
	.string "en je POKéMON.\p"
	.string "Daar draait het volgens mij om\n"
	.string "als GYMLEIDER.$"

PetalburgCity_Gym_Text_ParkerIntro:
	.string "Dit is de VERWARRINGSKAMER.\p"
	.string "Eens kijken hoe goed je band\n"
	.string "met je POKéMON is!$"

PetalburgCity_Gym_Text_ParkerDefeat:
	.string "Ik kon je team niet genoeg in de war\n"
	.string "brengen… Jullie band is sterk.$"

PetalburgCity_Gym_Text_ParkerPostBattle:
	.string "Daarna komt de KRACHTKAMER.\n"
	.string "Kun jij tegen pure kracht?$"

PetalburgCity_Gym_Text_ParkerPostBadge:
	.string "Sinds je onze LEIDER versloeg, is\n"
	.string "het trainen veel zwaarder.$"

PetalburgCity_Gym_Text_GeorgeIntro:
	.string "Net als je denkt dat je wint,\n"
	.string "krijgt je tegenstander HP terug…\p"
	.string "Kun je je voorstellen hoe erg\n"
	.string "dat voelt?\p"
	.string "Ik laat je zien hoe erg het\n"
	.string "voelt!$"

PetalburgCity_Gym_Text_GeorgeDefeat:
	.string "Ik kreeg niet genoeg HP terug…\n"
	.string "Wat een AANVAL…$"

PetalburgCity_Gym_Text_GeorgePostBattle:
	.string "Wat wil je ook van het kind van\n"
	.string "onze LEIDER.\p"
	.string "Nee, wacht! Wat een TRAINER kan,\n"
	.string "komt alleen door hard werken.\p"
	.string "Ik verloor omdat ik niet hard\n"
	.string "genoeg had gewerkt.\p"
	.string "Ga door! Hierna komt de KO-KAMER.$"

PetalburgCity_Gym_Text_GeorgePostBadge:
	.string "Ik blijf in GYMS trainen.\n"
	.string "Ooit word ik een LEIDER.$"

PetalburgCity_Gym_Text_BerkeIntro:
	.string "Ik ga niet zacht doen omdat je\n"
	.string "het kind van onze LEIDER bent.\p"
	.string "Ik laat je zien hoe erg het is als\n"
	.string "een POKéMON een voltreffer krijgt!$"

PetalburgCity_Gym_Text_BerkeDefeat:
	.string "Wat een kracht…\n"
	.string "Jij bent echt goed.$"

PetalburgCity_Gym_Text_BerkePostBattle:
	.string "Je vader is echt sterk.\n"
	.string "Ik heb veel respect voor hem.\p"
	.string "En ik zie bij jou dezelfde gloed\n"
	.string "als bij je vader.\p"
	.string "Ik hoop dat je een geweldig\n"
	.string "gevecht met je vader hebt!$"

PetalburgCity_Gym_Text_BerkePostBadge:
	.string "Sinds je vader de LEIDER is,\n"
	.string "zijn de TRAINERS van PETALBURG CITY\l"
	.string "veel sterker geworden.$"

PetalburgCity_Gym_Text_MaryIntro:
	.string "Hihi…\n"
	.string "Dit is de RAAKKANSKAMER.\p"
	.string "Het is best gemeen als elke\n"
	.string "aanval raak is.$"

PetalburgCity_Gym_Text_MaryDefeat:
	.string "Jij was beter dan ik…$"

PetalburgCity_Gym_Text_MaryPostBattle:
	.string "Er wachten nog sterkere\n"
	.string "TRAINERS op je.\p"
	.string "Links is de VERDEDIGINGSKAMER en\n"
	.string "rechts de HERSTELKAMER.\p"
	.string "In allebei wordt de AANVAL van je\n"
	.string "POKéMON getest.$"

PetalburgCity_Gym_Text_MaryPostBadge:
	.string "Weet je wat wij als TRAINERS\n"
	.string "willen bereiken?\p"
	.string "We willen echte maatjes worden\n"
	.string "met onze POKéMON.$"

PetalburgCity_Gym_Text_AlexiaIntro:
	.string "Hoe hoger de VERDEDIGING, hoe\n"
	.string "wilder ik kan aanvallen.$"

PetalburgCity_Gym_Text_AlexiaDefeat:
	.string "Onze verdediging was niet genoeg…$"

PetalburgCity_Gym_Text_AlexiaPostBattle:
	.string "Ik heb hier veel van je\n"
	.string "geleerd.\p"
	.string "Ga maar door! De linkerdeur gaat\n"
	.string "naar de KRACHTKAMER.\p"
	.string "De rechterdeur gaat naar\n"
	.string "de KO-KAMER.\p"
	.string "In allebei zitten TRAINERS die\n"
	.string "goed kunnen aanvallen.$"

PetalburgCity_Gym_Text_AlexiaPostBadge:
	.string "Hoi! Heb je SURFEN al geprobeerd?$"

PetalburgCity_Gym_Text_JodyIntro:
	.string "Onze GYMLEIDER zei dat we alles\n"
	.string "moeten geven om je te verslaan.\p"
	.string "Ook al ben je het kind van\n"
	.string "de LEIDER!$"

PetalburgCity_Gym_Text_JodyDefeat:
	.string "Maar… ik gaf alles!$"

PetalburgCity_Gym_Text_JodyPostBattle:
	.string "Hoe jij je POKéMON gebruikt…\n"
	.string "Het lijkt op je vader.\p"
	.string "Ga maar door! De GYMLEIDER,\n"
	.string "je vader, wacht op je!$"

PetalburgCity_Gym_Text_JodyPostBadge:
	.string "Natuurlijk is het goed om je POKéMON\n"
	.string "sterker te maken.\p"
	.string "Maar wie bepaalt wie er wint?\p"
	.string "Dat is wat een TRAINER voelt voor\n"
	.string "zijn POKéMON.$"

PetalburgCity_Gym_Text_DoorAppearsLocked:
	.string "Deze deur lijkt op slot\n"
	.string "te zitten…$"

PetalburgCity_Gym_Text_EnterSpeedRoom:
	.string "“SNELHEIDSKAMER”, staat er.\p"
	.string "Wil je naar binnen?$"

@ Unused
PetalburgCity_Gym_Text_DoorAppearsLocked2:
	.string "Deze deur lijkt op slot\n"
	.string "te zitten…$"

PetalburgCity_Gym_Text_EnterAccuracyRoom:
	.string "“RAAKKANSKAMER”, staat er.\p"
	.string "Wil je naar binnen?$"

PetalburgCity_Gym_Text_EnterConfusionRoom:
	.string "“VERWARRINGSKAMER”, staat er.\p"
	.string "Wil je naar binnen?$"

PetalburgCity_Gym_Text_EnterDefenseRoom:
	.string "“VERDEDIGINGSKAMER”, staat er.\p"
	.string "Wil je naar binnen?$"

PetalburgCity_Gym_Text_EnterRecoveryRoom:
	.string "“HERSTELKAMER”, staat er.\p"
	.string "Wil je naar binnen?$"

PetalburgCity_Gym_Text_EnterStrengthRoom:
	.string "“KRACHTKAMER”, staat er.\p"
	.string "Wil je naar binnen?$"

PetalburgCity_Gym_Text_EnterOHKORoom:
	.string "“KO-KAMER”, staat er.\p"
	.string "Wil je naar binnen?$"

PetalburgCity_Gym_Text_EnterGymLeadersRoom:
	.string "“KAMER VAN DE GYMLEIDER\p"
	.string "“Kom zelf kijken welke POKéMON op je\n"
	.string "wachten!”, staat er.\p"
	.string "Wil je naar binnen?$"

PetalburgCity_Gym_Text_GymStatue:
	.string "PETALBURG CITY POKéMON GYM$"

PetalburgCity_Gym_Text_GymStatueCertified:
	.string "PETALBURG CITY POKéMON GYM\p"
	.string "GOEDGEKEURDE TRAINERS VAN NORMAN:\n"
	.string "{PLAYER}$"

PetalburgCity_Gym_Text_NormanPreRematch:
	.string "PAPA: {PLAYER}…\n"
	.string "Ik dacht al dat je zou komen.\p"
	.string "Ik zeg nooit nee tegen een\n"
	.string "uitdaging van jou.\p"
	.string "Dat snap je toch?\p"
	.string "In een GYM maakt het niet uit dat\n"
	.string "we ouder en kind zijn.\p"
	.string "…Nee, juist omdat we ouder en kind zijn,\n"
	.string "moeten we allebei ons best doen.\l"
	.string "Toch, {PLAYER}?$"

PetalburgCity_Gym_Text_NormanRematchDefeat:
	.string "Eh… Haha…\n"
	.string "Misschien ging ik te hard…$"

PetalburgCity_Gym_Text_NormanPostRematch:
	.string "PAPA: {PLAYER}…\n"
	.string "Wat is jouw droom?\p"
	.string "Mijn droom…\n"
	.string "Hahaha…\l"
	.string "Die is eigenlijk al uitgekomen.$"

PetalburgCity_Gym_Text_NormanRematchNeedTwoMons:
	.string "PAPA: {PLAYER}…\n"
	.string "Ik dacht al dat je zou komen.\p"
	.string "Ik zeg nooit nee tegen een\n"
	.string "uitdaging van jou.\p"
	.string "Dat snap je toch?\p"
	.string "In een GYM maakt het niet uit dat\n"
	.string "we ouder en kind zijn.\p"
	.string "Hm? Wacht even, {PLAYER}.\p"
	.string "Heb je maar één POKéMON die\n"
	.string "kan vechten?\p"
	.string "Sorry, maar kom terug met minstens\n"
	.string "twee POKéMON.$"

