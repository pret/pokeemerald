	copyobjectxytoperm LOCALID_SOOTOPOLIS_WALLACE
	setvar VAR_SOOTOPOLIS_WALLACE_STATE, 2
	return

SootopolisCity_EventScript_GoToSkyPillar::
	msgbox SootopolisCity_Text_HaventYouScaledSkyPillar, MSGBOX_DEFAULT
	release
	end

SootopolisCity_EventScript_GoToGym::
	msgbox SootopolisCity_Text_DazzledByMentor, MSGBOX_DEFAULT
	release
	end

SootopolisCity_Movement_WallaceMoveFromGym:
	walk_right
	walk_in_place_faster_down
	step_end

SootopolisCity_Movement_WallaceMoveFromGymWest:
	walk_left
	walk_in_place_faster_down
	step_end

SootopolisCity_EventScript_Maxie::
	lockall
	goto_if_eq VAR_SOOTOPOLIS_CITY_STATE, 5, SootopolisCity_EventScript_MaxieRayquaza
	msgbox SootopolisCity_Text_GroudonPleaseStop, MSGBOX_DEFAULT
	closemessage
	releaseall
	end

SootopolisCity_EventScript_MaxieRayquaza::
	msgbox SootopolisCity_Text_AfterAllOurScheming, MSGBOX_DEFAULT
	setflag FLAG_MET_MAXIE_SOOTOPOLIS
	goto_if_set FLAG_MET_ARCHIE_SOOTOPOLIS, SootopolisCity_EventScript_MaxieArchieLeave
	releaseall
	end

SootopolisCity_EventScript_Archie::
	lockall
	goto_if_eq VAR_SOOTOPOLIS_CITY_STATE, 5, SootopolisCity_EventScript_ArchieRayquaza
	msgbox SootopolisCity_Text_KyogreCalmDown, MSGBOX_DEFAULT
	closemessage
	releaseall
	end

SootopolisCity_EventScript_ArchieRayquaza::
	msgbox SootopolisCity_Text_TryingMeaninglessToPokemon, MSGBOX_DEFAULT
	setflag FLAG_MET_ARCHIE_SOOTOPOLIS
	goto_if_set FLAG_MET_MAXIE_SOOTOPOLIS, SootopolisCity_EventScript_MaxieArchieLeave
	releaseall
	end

SootopolisCity_EventScript_MaxieArchieLeave::
	setflag FLAG_HIDE_SOOTOPOLIS_CITY_MAXIE
	setflag FLAG_HIDE_SOOTOPOLIS_CITY_ARCHIE
	setflag FLAG_SOOTOPOLIS_ARCHIE_MAXIE_LEAVE
	clearflag FLAG_HIDE_MT_PYRE_SUMMIT_MAXIE
	clearflag FLAG_HIDE_MT_PYRE_SUMMIT_ARCHIE
	setvar VAR_MT_PYRE_STATE, 2
	warpsilent MAP_SOOTOPOLIS_CITY, 31, 34
	waitstate
	releaseall
	end

@ Unused
SootopolisCity_Movement_Levitate::
	levitate
	step_end

@ Unused
SootopolisCity_Movement_DestroyTask::
	destroy_extra_task
	step_end

SootopolisCity_Text_GymSign:
	.string "SOOTOPOLIS CITY POKéMON GYM\n"
	.string "LEIDER: JUAN\p"
	.string "“De GYMLEIDER met de schoonheid\n"
	.string "van puur water!”$"

SootopolisCity_Text_CitySign:
	.string "SOOTOPOLIS CITY\p"
	.string "“De mystieke stad waar de\n"
	.string "geschiedenis slaapt.”$"

SootopolisCity_Text_DoorIsClosed:
	.string "De deur is dicht.$"

SootopolisCity_Text_PhysicallyFitLivingHere:
	.string "Duiken in zee. De hele dag trappen\n"
	.string "op en af…\p"
	.string "Als je in deze stad woont, word je\n"
	.string "vanzelf fit.$"

SootopolisCity_Text_GiantPokemonSuddenlyAppeared:
	.string "Deze reuzen-POKéMON kwamen ineens\n"
	.string "midden in de stad!\p"
	.string "Ik heb ze nog nooit gezien!\p"
	.string "Waarom botsen ze zo tegen elkaar?\p"
	.string "Waarom kunnen ze geen vrienden\n"
	.string "zijn, die POKéMON?$"

SootopolisCity_Text_WhatIsThatGreenPokemon:
	.string "Wat? Wat? Wat?\n"
	.string "Wat is die groene POKéMON?!$"

SootopolisCity_Text_WhereDidLegendariesGo:
	.string "GROUDON en KYOGRE…\n"
	.string "Waar zijn ze heen?\p"
	.string "Veroorzaken ze ergens anders\n"
	.string "droogte of zware regen?$"

SootopolisCity_Text_TwoPokemonArentAngry:
	.string "Ik voel op de een of andere manier\n"
	.string "dat die twee POKéMON niet boos zijn.\p"
	.string "Ik denk… Ze kunnen hun eigen kracht\n"
	.string "vast niet beheersen…$"

SootopolisCity_Text_FlyingMonStoppedRampage:
	.string "Die vliegende POKéMON kwam uit de\n"
	.string "lucht en stopte de razende\l"
	.string "POKéMON…$"

SootopolisCity_Text_WonderWhatWorldIsLike:
	.string "Ik… Ik ben nog nooit uit deze stad\n"
	.string "geweest.\p"
	.string "Hoe zou de wereld zijn aan de\n"
	.string "andere kant van deze ronde lucht?$"

SootopolisCity_Text_ThisIsWicked:
	.string "Wow!\n"
	.string "Dit is gaaf!$"

SootopolisCity_Text_ThatWasWicked:
	.string "Wow!\n"
	.string "Dat was gaaf!$"

SootopolisCity_Text_GoRedAndBlueMon:
	.string "Kom op, rode POKéMON!\n"
	.string "Geef niet op, blauwe POKéMON!$"

SootopolisCity_Text_DoYouKnowMonNames:
	.string "… … … … … …\p"
	.string "Hoi, weet jij hoe die POKéMON\n"
	.string "heten die daar vechten?$"

SootopolisCity_Text_GreenOneSettlesThings:
	.string "Ik vroeg me af wie zou winnen,\n"
	.string "de rode of de blauwe, maar nee,\l"
	.string "de groene beslist het!\p"
	.string "Wat een enorme wending!$"

SootopolisCity_Text_SeeingLegendWithOwnEyes:
	.string "Een oude legende zegt dat land en\n"
	.string "zee zijn gemaakt door een enorme\l"
	.string "strijd tussen POKéMON.\p"
	.string "Nou, ik zie het met mijn eigen\n"
	.string "ogen gebeuren!\p"
	.string "Wow! Ik had nooit gedacht dat ik\n"
	.string "zoiets groots zou zien!$"

SootopolisCity_Text_SawLegendWithOwnEyes:
	.string "Een oude legende zegt dat land en\n"
	.string "zee zijn gemaakt door een enorme\l"
	.string "strijd tussen POKéMON.\p"
	.string "Nou, ik zag het met mijn eigen\n"
	.string "ogen gebeuren!\p"
	.string "Wow! Ik had nooit gedacht dat ik\n"
	.string "zoiets groots zou zien!$"

SootopolisCity_Text_BigPokemonFighting:
	.string "Een grote POKéMON vecht met\n"
	.string "een andere grote POKéMON!\p"
	.string "Alsjeblieft, laat iemand ze stoppen!$"

SootopolisCity_Text_PrettyMonCameFromSky:
	.string "Een mooie POKéMON kwam uit de\n"
	.string "lucht…$"

SootopolisCity_Text_SootopolisWillBeWrecked:
	.string "Oh nee!\n"
	.string "SOOTOPOLIS CITY gaat kapot!$"

SootopolisCity_Text_SootopolisDidntGetWrecked:
	.string "SOOTOPOLIS CITY is niet kapotgegaan!$"

SootopolisCity_Text_NoOrdinaryTourist:
	.string "Hm!\n"
	.string "Je bent helemaal naar SOOTOPOLIS\l"
	.string "gekomen? Jij bent geen gewone toerist.\p"
	.string "Maar dat maakt je ook niet\n"
	.string "meteen een bijzondere toerist.$"

SootopolisCity_Text_CityRegainedCalm:
	.string "De stad is weer rustig…$"

SootopolisCity_Text_CaveOfOriginPleaseLeave:
	.string "Wie ben jij?\p"
	.string "Dit is de CAVE OF ORIGIN.\p"
	.string "De zielen van POKéMON, tot rust\n"
	.string "gebracht op MT. PYRE, komen hier\l"
	.string "weer tot leven.\p"
	.string "Ga alsjeblieft weg.$"

SootopolisCity_Text_LeadSuperiorTrainerToCave:
	.string "Iemand met een sterke wil en\n"
	.string "uitstekend talent…\p"
	.string "Een TRAINER met kennis en ervaring\n"
	.string "van veel soorten POKéMON…\p"
	.string "Als zo iemand komt, moest ik van\n"
	.string "WALLACE die TRAINER naar deze\l"
	.string "grot brengen.$"

SootopolisCity_Text_AwakenedPokemonClash:
	.string "Oh jee…\p"
	.string "De botsing tussen de twee\n"
	.string "ontwaakte POKéMON werd gestopt\l"
	.string "door het ontwaken van een derde…$"

SootopolisCity_Text_CaveOfOriginSleepsToo:
	.string "Dit is de CAVE OF ORIGIN…\p"
	.string "Nu de crisis voorbij is,\n"
	.string "zal de grot ook slapen…$"

SootopolisCity_Text_SootopolisSkyBeautiful:
	.string "SOOTOPOLIS ontstond als stad in\n"
	.string "de krater van een vulkaan.\p"
	.string "Als je omhoog kijkt, zie je ook\n"
	.string "de rand van de krater.\l"
	.string "Je ziet de lucht dus als een cirkel.\p"
	.string "Maar daarom is de lucht boven\n"
	.string "SOOTOPOLIS het mooist.$"

SootopolisCity_Text_GiganticPokemonFight:
	.string "Als twee zulke enorme POKéMON zo\n"
	.string "wild vechten, kunnen wij weinig\l"
	.string "doen.$"

SootopolisCity_Text_FearedWorstWhenPokemonFlewDown:
	.string "Toen die derde POKéMON naar\n"
	.string "beneden vloog, vreesde ik het\l"
	.string "ergste.$"

SootopolisCity_Text_NightSkyFavoriteScenery:
	.string "Een cirkel van nachtlucht in de\n"
	.string "krater van een vulkaan…\p"
	.string "En in die ring flikkeren de sterren\n"
	.string "alsof ze leven…\l"
	.string "Het is mijn favoriete uitzicht.$"

SootopolisCity_Text_WeatherWentWild:
	.string "Vanochtend was het helder,\n"
	.string "maar…\p"
	.string "Opeens kwamen er donkere wolken,\n"
	.string "begon het te gieten en was er\l"
	.string "onweer met bliksem.\p"
	.string "Het weer werd helemaal gek!\p"
	.string "Komt dat allemaal door die\n"
	.string "POKéMON?$"

SootopolisCity_Text_YouBroughtFlyingMon:
	.string "Oh?\p"
	.string "Jij hebt die vliegende POKéMON\n"
	.string "hierheen gebracht?\p"
	.string "Nou, wat ben jij geweldig!$"

SootopolisCity_Text_GroudonPleaseStop:
	.string "MAXIE: G… GROUDON…\n"
	.string "Alsjeblieft! Stop ermee!\p"
	.string "Ik ken nu de omvang van je kracht!\p"
	.string "Als je doorgaat, wordt heel HOENN\n"
	.string "verwoest, niet alleen SOOTOPOLIS!$"

SootopolisCity_Text_AfterAllOurScheming:
	.string "MAXIE: Dus de oeroude POKéMON\n"
	.string "waren niet alleen GROUDON en KYOGRE…\p"
	.string "Na al ons vruchteloze gekonkel\n"
	.string "en wanhopige moeite zet één POKéMON\l"
	.string "met een simpele daad alles recht,\l"
	.string "alsof er niets gebeurd was…\p"
	.string "Fu…\n"
	.string "Fuhahaha…$"

SootopolisCity_Text_KyogreCalmDown:
	.string "ARCHIE: KYOGRE! Wat is er?!\n"
	.string "Kijk hier! Het is de RODE BOL!\l"
	.string "Kom tot rust! KYOGRE!\p"
	.string "… … … … … …\n"
	.string "… … … … … …\p"
	.string "Het helpt niet!\n"
	.string "Hij reageert helemaal niet!$"

SootopolisCity_Text_TryingMeaninglessToPokemon:
	.string "ARCHIE: KYOGRE en GROUDON zijn\n"
	.string "beiden weggevlogen, wie weet waarheen.\p"
	.string "Het weer in HOENN is weer\n"
	.string "normaal…\p"
	.string "Haha…\n"
	.string "Hahaha…\p"
	.string "Misschien was wat wij probeerden\n"
	.string "voor POKéMON iets kleins, zelfs\l"
	.string "betekenisloos…$"

SootopolisCity_Text_InvolvedWithCrisisComeWithMe:
	.string "STEVEN: Die POKéMON die vechten…\n"
	.string "GROUDON… En KYOGRE…\p"
	.string "De twee oeroude POKéMON zijn\n"
	.string "wakker geworden na lange slaap…\p"
	.string "En nu slaan ze op elkaar met hun\n"
	.string "onbeheersbare energie…\p"
	.string "…{PLAYER}{KUN}.\p"
	.string "Dat je hier bent, zie ik als teken\n"
	.string "dat je bij deze crisis wilt helpen.\p"
	.string "Nou, er is iemand die ik je\n"
	.string "wil laten ontmoeten.\p"
	.string "Kom met me mee, alsjeblieft.$"

SootopolisCity_Text_DoesThisMakeYourFearPokemon:
	.string "STEVEN: Luister, {PLAYER}{KUN}.\p"
	.string "Denk je door GROUDON en KYOGRE\n"
	.string "dat je bang moet zijn voor POKéMON?\p"
	.string "Maar dat is niet zo.\n"
	.string "POKéMON zijn eigenlijk meer…\p"
	.string "…Waarom vraag ik dit?\n"
	.string "Je weet het al.$"

SootopolisCity_Text_HereWereAreHelpWallace:
	.string "STEVEN: Oké, we zijn er!\p"
	.string "Hierbinnen vind je iemand die\n"
	.string "WALLACE heet.\p"
	.string "Ik denk dat jij kunt helpen…$"

SootopolisCity_Text_KnowWhatsNeededToHelpHim:
	.string "STEVEN: Ik denk dat jij hebt wat\n"
	.string "nodig is om hem te helpen…$"

SootopolisCity_Text_NeverBeenToSkyPillar:
	.string "STEVEN: De SKY PILLAR…\p"
	.string "Ik ben er nooit geweest.\n"
	.string "Waar zou die zijn?$"

SootopolisCity_Text_SoThatsRayquaza:
	.string "STEVEN: Dus dat is RAYQUAZA…\p"
	.string "Ongelofelijk, dat de twee razende\n"
	.string "POKéMON er bang voor vluchten…$"

SootopolisCity_Text_MaxieArchieLeft:
	.string "STEVEN: MAXIE en ARCHIE zijn\n"
	.string "beiden ergens heen gegaan.\p"
	.string "Misschien naar MT. PYRE om die\n"
	.string "BOLLEN terug te brengen…$"

SootopolisCity_Text_HaventYouScaledSkyPillar:
	.string "WALLACE: Oh?\n"
	.string "{PLAYER}{KUN}?\p"
	.string "Ben je nog niet op de SKY PILLAR\n"
	.string "geklommen?\p"
	.string "Ik weet zeker dat je de top van\n"
	.string "de SKY PILLAR kunt halen…$"

SootopolisCity_Text_AquaMagmaDidntMeanHarm:
	.string "WALLACE: {PLAYER}{KUN}…\p"
	.string "De leiders van TEAM MAGMA en AQUA\n"
	.string "bedoelden denk ik geen kwaad.\p"
	.string "Het kan geen kwaad om te horen\n"
	.string "wat zij te zeggen hebben.$"

SootopolisCity_Text_ThankYouForHelpAcceptThis:
	.string "WALLACE: {PLAYER}{KUN}…\n"
	.string "Mijn ogen bedrogen me niet.\p"
	.string "Dankzij jou is SOOTOPOLIS…\n"
	.string "Nee, heel HOENN gered.\p"
	.string "Namens de mensen bedank ik je.\p"
	.string "Dit is een cadeau van mij.\n"
	.string "Neem het alsjeblieft aan.$"

SootopolisCity_Text_ExplainWaterfallGoToGym:
	.string "Die VERBORGEN MACHINE bevat\n"
	.string "WATERVAL.\p"
	.string "Heb je de RAIN BADGE, dan kan een\n"
	.string "POKéMON met die HM-aanval\l"
	.string "omhoog door waterval klimmen.\p"
	.string "En waar krijg je de RAIN BADGE?\n"
	.string "Je weet het vast!\p"
	.string "Precies! Je moet de GYMLEIDER van\n"
	.string "SOOTOPOLIS verslaan.\p"
	.string "Als je klaar bent, ga je\n"
	.string "door die deur.$"

SootopolisCity_Text_DazzledByMentor:
	.string "WALLACE: Je zult vast versteld staan\n"
	.string "van de adembenemend sierlijke\l"
	.string "vechtstijl van mijn leraar.$"
